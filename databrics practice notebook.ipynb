   "source": [
    "item_price = 120.00\n",
    "tax_rate=  20\n",
    "discount = 10.00\n",
    "## calculate tax\n",
    "tax = item_price*(tax_rate/100)\n",
    "\n",
    "## apply tax in the item\n",
    "item_price_with_tax = item_price - tax\n",
    "## appply flat dicount\n",
    "final_price = item_price_with_tax - discount\n",
    "\n",
    "print(f\"final price :{final_price:.2f}\")"
   ]
